{
  "name": "@docstack/pouchdb-adapter-native",
  "description": "PouchDB adapter over docstack-store's envelope protocol. One implementation, carrier injected (WebView or headless).",
  "version": "0.0.1",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js"
  },
  "src": "src/index.ts",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -build --force ./tsconfig.json",
    "pretest": "npm run build",
    "test": "mocha"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onyx-ac/pouchdb-adapter-native.git"
  },
  "author": "Onyx <hello@onyx.ac> (https://onyx.ac)",
  "license": "CC-BY-SA-4.0",
  "keywords": [
    "pouchdb",
    "adapter",
    "docstack"
  ],
  "devDependencies": {
    "typescript": "^5.7.3",
    "pouchdb-core": "^9.0.0",
    "mocha": "^11.1.0",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2"
  }
}
